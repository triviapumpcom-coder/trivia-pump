{
  "name": "quizbot-monorepo",
  "private": true,
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "build": "echo 'Building frontend...' && cd apps/web && npm install && npm run build && echo 'Frontend build complete!'",
    "start": "node server.js",
    "heroku-postbuild": "cd apps/api && npm install && npm run build && cd ../web && npm install && npm run build",
    "build:web": "cd apps/web && npm run build",
    "build:api": "cd apps/api && npm run build",
    "start:api": "cd apps/api && npm start",
    "db:generate": "cd apps/api && npm run db:generate",
    "db:push": "cd apps/api && npm run db:push",
    "db:migrate": "cd apps/api && npm run db:migrate"
  },
  "engines": {
    "node": "18.x"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "@vitejs/plugin-react": "^4.3.2"
  }
}


